<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NestCoop</AssemblyName>
    <RootNamespace>NestCoop</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- net6 is out of support; MelonLoader's IL2CPP runtime still targets it. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!--
    Paths. Override per machine without editing this file:
      dotnet build -p:ProfilePath="..."   or set them in Directory.Build.props.user (gitignored).
    GamePath    = the Steam install (GameAssembly.dll, global-metadata.dat).
    ProfilePath = the r2modman profile. MelonLoader, Mods/ and Il2CppAssemblies/ live here, NOT in GamePath.
  -->
  <Import Project="..\Directory.Build.props.user" Condition="Exists('..\Directory.Build.props.user')" />
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">B:\SteamLibrary\steamapps\common\Iron Nest Heavy Turret Simulator</GamePath>
    <ProfilePath Condition="'$(ProfilePath)' == ''">$(APPDATA)\r2modmanPlus-local\IronNestHeavyTurretSimulator\profiles\Default</ProfilePath>
    <!-- Second r2modman profile for the 2nd local instance (two instances can't share one profile's MelonLoader folder).
         Deployed to only if it exists. -->
    <GuestProfilePath Condition="'$(GuestProfilePath)' == ''">$(APPDATA)\r2modmanPlus-local\IronNestHeavyTurretSimulator\profiles\Guest</GuestProfilePath>
    <MLPath>$(ProfilePath)\MelonLoader</MLPath>
    <Il2CppAsm>$(MLPath)\Il2CppAssemblies</Il2CppAsm>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference><Private>false</Private></Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MLPath)\net6\MelonLoader.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLPath)\net6\0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MLPath)\net6\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(MLPath)\net6\Il2CppInterop.Common.dll</HintPath></Reference>

    <Reference Include="Assembly-CSharp"><HintPath>$(Il2CppAsm)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppAsm)\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppAsm)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Il2CppAsm)\UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppAsm)\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(Il2CppAsm)\Unity.InputSystem.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Il2CppAsm)\UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppAsm)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppAsm)\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppAsm)\UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="Il2CppNewtonsoft.Json"><HintPath>$(Il2CppAsm)\Il2CppNewtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppAsm)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Milestone 3 transport (localhost testing). Deployed to the profile's UserLibs/ by DeployToProfile. -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.5" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CheckPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MLPath)\net6\MelonLoader.dll')" Text="MelonLoader not found under ProfilePath='$(ProfilePath)'. Install LavaGang-MelonLoader in r2modman and launch modded once." />
    <Error Condition="!Exists('$(Il2CppAsm)\Assembly-CSharp.dll')" Text="Il2CppAssemblies missing under '$(Il2CppAsm)'. Launch the game modded once to generate them." />
  </Target>

  <Target Name="DeployToProfile" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfilePath)\Mods" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="NestCoop -> $(ProfilePath)\Mods" />
    <!-- Dependencies go in UserLibs/ (MelonLoader loads them before mods). -->
    <Copy SourceFiles="$(PkgLiteNetLib)\lib\netstandard2.1\LiteNetLib.dll" DestinationFolder="$(ProfilePath)\UserLibs" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="LiteNetLib -> $(ProfilePath)\UserLibs" />

    <!-- Guest profile (2nd local instance), only if it has been created in r2modman. -->
    <Copy Condition="Exists('$(GuestProfilePath)\Mods')" SourceFiles="$(TargetPath)" DestinationFolder="$(GuestProfilePath)\Mods" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy Condition="Exists('$(GuestProfilePath)\UserLibs')" SourceFiles="$(PkgLiteNetLib)\lib\netstandard2.1\LiteNetLib.dll" DestinationFolder="$(GuestProfilePath)\UserLibs" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Condition="Exists('$(GuestProfilePath)\Mods')" Importance="high" Text="NestCoop -> $(GuestProfilePath)\Mods (guest profile)" />
  </Target>

  <!--
    r2modman / Thunderstore package:  dotnet build NestCoop -c Release -t:Package
    Layout (same as other MelonLoader packages for this game): manifest.json, README.md, icon.png, Mods/, UserLibs/.
    The version comes from Mod.Version in Mod.cs, so the package and the network version check always agree.
    Output: dist/TDWolff-NestCoop-<version>.zip
  -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Mod.cs')), 'Version = "([0-9]+\.[0-9]+\.[0-9]+)"').Groups[1].Value)</ModVersion>
      <PackagingDir>$(MSBuildThisFileDirectory)..\packaging</PackagingDir>
      <DistDir>$(MSBuildThisFileDirectory)..\dist</DistDir>
      <PkgStage>$(DistDir)\stage</PkgStage>
      <PkgZip>$(DistDir)\TDWolff-NestCoop-$(ModVersion).zip</PkgZip>
      <ManifestJson>$([System.IO.File]::ReadAllText('$(PackagingDir)\manifest.template.json').Replace('@VERSION@', '$(ModVersion)'))</ManifestJson>
    </PropertyGroup>
    <Error Condition="'$(ModVersion)' == ''" Text="Package: couldn't read Version = &quot;x.y.z&quot; from Mod.cs" />

    <RemoveDir Directories="$(PkgStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PkgStage)\Mods" />
    <Copy SourceFiles="$(PkgLiteNetLib)\lib\netstandard2.1\LiteNetLib.dll" DestinationFolder="$(PkgStage)\UserLibs" />
    <Copy SourceFiles="$(PackagingDir)\README.md;$(PackagingDir)\CHANGELOG.md;$(PackagingDir)\icon.png" DestinationFolder="$(PkgStage)" />
    <!-- Thunderstore rejects a manifest.json with a UTF-8 BOM, so write it with .NET's BOM-less UTF-8. -->
    <WriteLinesToFile File="$(PkgStage)\manifest.json" Lines="$(ManifestJson)" Overwrite="true" Encoding="utf-8" WriteOnlyWhenDifferent="false" />
    <Exec Command="powershell -NoProfile -Command &quot;$p='$(PkgStage)\manifest.json'; $t=[IO.File]::ReadAllText($p); [IO.File]::WriteAllText($p, $t, (New-Object Text.UTF8Encoding $false))&quot;" />

    <MakeDir Directories="$(DistDir)" />
    <Delete Files="$(PkgZip)" />
    <ZipDirectory SourceDirectory="$(PkgStage)" DestinationFile="$(PkgZip)" Overwrite="true" />
    <Message Importance="high" Text="Package -> $(PkgZip)" />
  </Target>

</Project>
